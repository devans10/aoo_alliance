# ─────────────────────────────────────────────
# Age of Origins Alliance Stats Bot — .env
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Discord bot token (from discord.com/developers → Your App → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheet ID
# This is the long string in your Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account credentials — choose ONE method:

# Option A: Path to a local JSON file (easier for local/Bluefin hosting)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option B: Paste the entire JSON as a single line (better for cloud hosting like Railway)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Path to the SQLite database file
DB_PATH=alliance.db

# Optional: Restrict the bot to one Discord channel
# Leave blank to allow responses in any channel where the bot is present
# Get the channel ID by right-clicking a channel in Discord (Developer Mode must be on)
STATS_CHANNEL_ID=
KNOWLEDGE_BASE_SHEET_ID=